# --- Source material and media: never committed (copyrighted / large) --------------------------------
# Put the sample PDFs and the chapter MP3 in the repo root locally; tests that need them skip when absent.
*.pdf
*.mp3
*.wav
*.m4a
*.flac
*.ogg
*.aac

# --- Run outputs (all regenerated by the scripts) ----------------------------------------------------------
audio-outs/
pdf-outs/
text-outs/
output/
full-out/
*-out/
*-outs/
pdf-extractor/out/
extracted/
romanized/

# --- Standalone executables (./build-executables.sh) ------------------------------------------------------
dist/
.build/
*.spec

# --- Python / tooling ---------------------------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# --- OS / editor -------------------------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/

# Claude Code: personal settings stay local (shared .claude/settings.json is committed)
.claude/settings.local.json

# stray empty folder created by a system library at runtime
pdf-extractor/{{HOMEBREW_PREFIX}}/
